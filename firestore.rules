rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null;
      // Allow if it's your own profile OR if it's a test data seed
      allow write: if request.auth != null && 
                  (request.auth.uid == userId || userId.matches('^seed_.*'));
    }

    // Bookings Collection
    // Only the two parties on a booking can read or modify it.
    match /bookings/{bookingId} {
      allow read: if request.auth != null &&
                  (request.auth.uid == resource.data.mentorId ||
                   request.auth.uid == resource.data.entrepreneurId);

      allow create: if request.auth != null &&
                    request.resource.data.entrepreneurId == request.auth.uid;

      allow update: if request.auth != null &&
                    (request.auth.uid == resource.data.mentorId ||
                     request.auth.uid == resource.data.entrepreneurId);
    }

    // Resources Collection 
    match /resources/{resourceId} {
      allow read: if request.auth != null;
      // Only allow creation/updates if the user's role is 'mentor'
      allow create, update, delete: if request.auth != null && 
                    get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'mentor';
    }

    // Community Feed (Posts & Replies)
    match /posts/{postId} {
      allow read: if request.auth != null;
      // Only the author can create a post under their name
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      
      // Restrict updates to the safe community-action fields only.
      // Prevents any user from editing another user's post body or title.
      allow update: if request.auth != null &&
                    request.resource.data.diff(resource.data).affectedKeys()
                      .hasOnly(['upvotes', 'upvotedBy', 'reportCount', 'reportedBy', 'flagged', 'replyCount']);
      
      // Authors can delete their own posts
      allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;

      match /replies/{replyId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update: if request.auth != null &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['reportCount', 'reportedBy', 'flagged']);
        allow delete: if request.auth != null && request.auth.uid == resource.data.authorId;
      }
    }
  }
}